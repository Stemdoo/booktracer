# Copy these names into your local environment or Render Environment settings.
# Do not put real secrets in this file.
DJANGO_SECRET_KEY=replace-with-a-strong-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-service.onrender.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
