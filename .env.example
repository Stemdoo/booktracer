# Copy to .env for local use. Never commit a real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave empty for local SQLite; set Render's Internal Database URL on Render.
DATABASE_URL=
